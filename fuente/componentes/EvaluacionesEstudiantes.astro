      cursos: ['Visualizacion y Storytelling', 'Laboratorio de Animacion', 'Narrativa Transmedia'],
    },
  ],
  2023: [
    {
      periodo: '2023-2',
      principal: '202320-PRINCIPAL-JUAN CAMILO GONZALEZ JIMENEZ.pdf',
      comparado: '202320-COMPARADO-JUAN CAMILO GONZALEZ JIMENEZ.pdf',
      imagen: '/imagenes/evaluacion-202320.png',
      cursos: ['Cultura Digital', 'Laboratorio de Animacion', 'Datos y Representacion', 'Narrativa Transmedia'],
    },
    {
      periodo: '2023-1',
      principal: '202310-PRINCIPAL-JUAN CAMILO GONZALEZ JIMENEZ.pdf',
