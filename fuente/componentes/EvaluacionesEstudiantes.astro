  2019: [
    {
      periodo: '2019-2',
      principal: '201920-PRINCIPAL-JUAN CAMILO GONZALEZ JIMENEZ.pdf',
      comparado: '201920-COMPARADO-JUAN CAMILO GONZALEZ JIMENEZ.pdf',
      imagen: '/imagenes/evaluacion-201920.png',
      cursos: ['Narrativa Multimedia', 'Datos y Representacion'],
    },
  ],
};

const anos = Object.keys(evaluacionesPorAno).sort((a, b) => Number(b) - Number(a));

const [cursosPregrado, cursosMaestria] = await Promise.all([
  getCollection('cursosPregrado'),
  getCollection('cursosMaestria'),
]);

const cursosPorPeriodo = [...cursosPregrado, ...cursosMaestria].reduce(
  (acumulado, curso) => {
    for (const ciclo of curso.data.ciclos) {
      if (!acumulado[ciclo]) {
        acumulado[ciclo] = [];
      }

      acumulado[ciclo].push(curso.data.titulo.trim());
    }

    return acumulado;
  },
  {} as Record<string, string[]>
);
---

<div class="evaluaciones-estudiantes">
  <div class="evaluaciones-por-ano">
    {
      anos.map((ano) => (
        <div class="ano-seccion">
          <div class="periodos-lista">
            {evaluacionesPorAno[Number(ano) as keyof typeof evaluacionesPorAno].map((evaluacion) => {
              const cursosDelPeriodo = cursosPorPeriodo[evaluacion.periodo] || evaluacion.cursos;

              return (
                <div class="periodo-card">
                  <div class="card-header">
                    <h5 class="periodo-titulo">{evaluacion.periodo}</h5>
                    <div class="documentos-enlaces">
                      <a
                        href={`/pdfs/evaluaciones/${evaluacion.principal}`}
                        target="_blank"
                        class="link-documento principal"
                      >
                        Reporte Principal
                      </a>
                      {evaluacion.comparado && (
                        <a
                          href={`/pdfs/evaluaciones/${evaluacion.comparado}`}
                          target="_blank"
                          class="link-documento comparado"
                        >
                          Reporte Comparado
                        </a>
                      )}
                    </div>
                  </div>

                  <div class="card-body">
                    {evaluacion.imagen && (
                      <div class="seccion-imagen">
                        <img
                          src={evaluacion.imagen}
                          alt={`Grafica comparativa de evaluaciones - ${evaluacion.periodo}`}
                          loading="lazy"
                          decoding="async"
                        />
                        <p class="descripcion-imagen">
                          Comparacion de promedios: Juan Camilo Gonzalez vs Facultad de Artes y Humanidades vs
                          Universidad
                        </p>
                      </div>
                    )}

                    <div class="seccion-cursos">
                      <h6>Cursos dictados</h6>
                      <ul class="lista-cursos">
                        {cursosDelPeriodo.map((curso) => (
                          <li>{curso}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</div>
