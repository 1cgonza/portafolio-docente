const anos = Object.keys(evaluacionesPorAno).sort((a, b) => Number(b) - Number(a));
---

<div class="evaluaciones-estudiantes">
  <!-- Introducción -->
  <div class="introduccion">
    <p>
      Cada periodo presenta un resumen que incluye los cursos dictados, los aspectos destacados según los estudiantes,
      los aspectos por mejorar cuando fue el caso, y una reflexión sobre lo que significó ese momento en mi trayectoria
      docente. Las gráficas comparativas muestran mis promedios de evaluación en relación con los de la Facultad de
      Artes y Humanidades y la Universidad. Los dos documentos oficiales de cada periodo—<strong
        >Reporte Principal</strong
      >
      y <strong>Reporte Comparado</strong>—son documentos en PDF con toda la información detallada, y están disponibles
      para consulta.
    </p>
  </div>

  <!-- Evaluaciones por periodo -->
  <div class="evaluaciones-por-ano">
    {
      anos.map((ano) => (
        <div class="ano-seccion">
          <div class="periodos-lista">
            {evaluacionesPorAno[ano].map((evaluacion) => (
              <div class="periodo-card">
                <div class="card-header">
                  <h5 class="periodo-titulo">{evaluacion.periodo}</h5>
                  <div class="documentos-enlaces">
                    <a
                      href={`/pdfs/evaluaciones/${evaluacion.principal}`}
                      target="_blank"
                      class="link-documento principal"
                    >
                      Reporte Principal
                    </a>
                    {evaluacion.comparado && (
                      <a
                        href={`/pdfs/evaluaciones/${evaluacion.comparado}`}
                        target="_blank"
                        class="link-documento comparado"
                      >
                        Reporte Comparado
                      </a>
                    )}
                  </div>
                </div>

                <div class="card-body">
                  {evaluacion.imagen && (
                    <div class="seccion-imagen">
                      <img
                        src={evaluacion.imagen}
                        alt={`Gráfica comparativa de evaluaciones - ${evaluacion.periodo}`}
                      />
                      <p class="descripcion-imagen">
                        Comparación de promedios: Juan Camilo González vs Facultad de Artes y Humanidades vs Universidad
                      </p>
                    </div>
                  )}

                  <div class="seccion-cursos">
                    <h6>Cursos dictados</h6>
                    <ul class="lista-cursos">
                      {evaluacion.cursos.map((curso) => (
                        <li>{curso}</li>
                      ))}
                    </ul>
                  </div>

                  {evaluacion.aspectosPositivos.length > 0 && (
                    <div class="seccion-aspectos positivos">
                      <h6>✓ Aspectos destacados</h6>
                      <ul>
                        {evaluacion.aspectosPositivos.map((aspecto) => (
                          <li>{aspecto}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {evaluacion.aspectosPorMejorar.length > 0 && (
                    <div class="seccion-aspectos por-mejorar">
                      <h6>→ Aspectos por mejorar</h6>
                      <ul>
                        {evaluacion.aspectosPorMejorar.map((aspecto) => (
                          <li>{aspecto}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <div class="seccion-reflexion">
                    <h6>Reflexión</h6>
                    <p>{evaluacion.reflexion}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
