---
import { getCollection, render } from 'astro:content';
import TarjetaMedia from './TarjetaMedia.astro';

type MetaItem = {
  etiqueta: string;
  valor: string;
  detalle?: string;
};

type LinkItem = {
  etiqueta: string;
  url: string;
};

type FundingItem = {
  tipo: 'interna' | 'externa' | 'FAPA' | 'institucional';
  entidad?: string;
};

type SectionItem = {
  titulo: string;
  items: Array<{
    titulo: string;
    url?: string;
    etiqueta?: string;
    meta?: string;
  }>;
};

const proyectos = await getCollection('proyectosInvestigacion');

const ANO = 'a\u00f1o';
const ANO_INICIO = 'a\u00f1o_inicio';
const ANO_FIN = 'a\u00f1o_fin';

function obtenerAno(proyecto: (typeof proyectos)[0], llave: string) {
  return proyecto.data[llave as keyof typeof proyecto.data] as number | undefined;
}

function obtenerClaveFecha(fecha: string | undefined, ano: number | undefined, tipo: 'inicio' | 'fin') {
  if (fecha) {
    const [anoTexto, mesTexto, diaTexto] = fecha.split('-');
    const anoNormalizado = Number(anoTexto);
    const mesNormalizado = Number(mesTexto);
    const diaNormalizado = diaTexto ? Number(diaTexto) : tipo === 'fin' ? 31 : 1;

    if (Number.isFinite(anoNormalizado) && Number.isFinite(mesNormalizado) && Number.isFinite(diaNormalizado)) {
      return anoNormalizado * 10000 + mesNormalizado * 100 + diaNormalizado;
    }
  }

  if (!ano) return 0;
  return tipo === 'fin' ? ano * 10000 + 1231 : ano * 10000 + 101;
}

function obtenerAnoInicio(proyecto: (typeof proyectos)[0]) {
  return obtenerAno(proyecto, ANO_INICIO) || obtenerAno(proyecto, ANO);
}

function obtenerAnoFin(proyecto: (typeof proyectos)[0]) {
  return obtenerAno(proyecto, ANO_FIN);
}

function estaEnCursoSinFechaFinal(proyecto: (typeof proyectos)[0]) {
  return proyecto.data.estado === 'en curso' && !proyecto.data.fecha_fin && !obtenerAnoFin(proyecto);
}

function obtenerClaveFinParaOrden(proyecto: (typeof proyectos)[0]) {
  if (estaEnCursoSinFechaFinal(proyecto)) {
    return 99991231;
  }

  return obtenerClaveFecha(proyecto.data.fecha_fin, obtenerAnoFin(proyecto) || obtenerAnoInicio(proyecto), 'fin');
}

function obtenerClaveInicioParaOrden(proyecto: (typeof proyectos)[0]) {
  return obtenerClaveFecha(proyecto.data.fecha_inicio, obtenerAnoInicio(proyecto), 'inicio');
}

function obtenerPeriodoDisplay(proyecto: (typeof proyectos)[0]) {
  const inicioBase = obtenerAnoInicio(proyecto);
  const finBase = obtenerAnoFin(proyecto);
  const inicio = inicioBase ? `${inicioBase}` : '';
  const fin = finBase ? `${finBase}` : '';

  if (inicio && fin && inicio !== fin) return `${inicio} - ${fin}`;
  if (inicio && proyecto.data.estado === 'en curso') return `${inicio} - presente`;
  return fin || inicio;
}

function formatearEtiquetaEnlace(key: string) {
  return key.replace(/_/g, ' ');
}

function normalizarFinanciacion(financiacion: FundingItem | FundingItem[] | undefined): FundingItem[] {
  if (!financiacion) return [];
  return Array.isArray(financiacion) ? financiacion : [financiacion];
}

function formatearTipoFinanciacion(tipo: FundingItem['tipo']) {
  if (tipo === 'FAPA') return 'FAPA';
  return tipo.charAt(0).toUpperCase() + tipo.slice(1);
}

const resumenSeccion = (() => {
  const conteos = {
    proyectos: proyectos.length,
    interna: 0,
    externa: 0,
    fapa: 0,
    institucional: 0,
    productos: 0,
    exhibiciones: 0,
    premios: 0,
  };

  proyectos.forEach((proyecto) => {
    normalizarFinanciacion(proyecto.data.financiacion).forEach((fuente) => {
      if (fuente.tipo === 'interna') conteos.interna += 1;
      if (fuente.tipo === 'externa') conteos.externa += 1;
      if (fuente.tipo === 'FAPA') conteos.fapa += 1;
      if (fuente.tipo === 'institucional') conteos.institucional += 1;
    });

    conteos.productos += proyecto.data.productos?.length || 0;
    conteos.exhibiciones += proyecto.data.exhibiciones?.length || 0;
    conteos.premios += proyecto.data.premios?.length || 0;
  });

  return [
    { etiqueta: 'Proyectos', valor: conteos.proyectos },
    { etiqueta: 'Financiaciones internas', valor: conteos.interna },
    { etiqueta: 'Financiaciones externas', valor: conteos.externa },
    { etiqueta: 'FAPA', valor: conteos.fapa },
    { etiqueta: 'Apoyos institucionales', valor: conteos.institucional },
    { etiqueta: 'Productos', valor: conteos.productos },
    { etiqueta: 'Exhibiciones', valor: conteos.exhibiciones },
    { etiqueta: 'Premios', valor: conteos.premios },
  ];
})();

proyectos.sort((a, b) => {
  const diffFin = obtenerClaveFinParaOrden(b) - obtenerClaveFinParaOrden(a);
  if (diffFin !== 0) return diffFin;

  const diffInicio = obtenerClaveInicioParaOrden(b) - obtenerClaveInicioParaOrden(a);
  if (diffInicio !== 0) return diffInicio;

  return a.data.titulo.localeCompare(b.data.titulo, 'es');
});
---

<section class="resumenProyectosInvestigacion" aria-labelledby="resumen-proyectos-investigacion">
  <div class="resumenProyectosInvestigacion__encabezado">
    <h4 id="resumen-proyectos-investigacion">Resumen de la seccion</h4>
    <p>Conteo automatico de proyectos, apoyos y resultados registrados en esta pagina.</p>
  </div>
  <div class="resumenProyectosInvestigacion__grid">
    {
      resumenSeccion.map((item) => (
        <div class="resumenProyectosInvestigacion__item">
          <span class="resumenProyectosInvestigacion__valor">{item.valor}</span>
          <span class="resumenProyectosInvestigacion__etiqueta">{item.etiqueta}</span>
        </div>
      ))
    }
  </div>
</section>

<div class="listadoTarjetasMedia proyectosInvestigacion">
  {
    proyectos.map(async (proyecto) => {
      const { Content } = await render(proyecto);
      const carpetaGaleria = proyecto.data.slug || proyecto.id.replace('.mdx', '').replace('.md', '');

      const metadatos: MetaItem[] = [];
      const secciones: SectionItem[] = [];
      const enlaces: LinkItem[] = [];

      if (proyecto.data.tipo) {
        metadatos.push({ etiqueta: 'Tipo', valor: proyecto.data.tipo });
      }
      if (proyecto.data.rol) {
        metadatos.push({ etiqueta: 'Rol', valor: proyecto.data.rol });
      }
      if (proyecto.data.area) {
        metadatos.push({ etiqueta: 'Area', valor: proyecto.data.area });
      }
      normalizarFinanciacion(proyecto.data.financiacion).forEach((fuente) => {
        metadatos.push({
          etiqueta: 'Financiacion',
          valor: formatearTipoFinanciacion(fuente.tipo),
          detalle: fuente.entidad,
        });
      });
      if (typeof proyecto.data.estudiantes_involucrados === 'number') {
        metadatos.push({ etiqueta: 'Estudiantes', valor: `${proyecto.data.estudiantes_involucrados}` });
      }
      if (proyecto.data.sede) {
        metadatos.push({ etiqueta: 'Sede', valor: proyecto.data.sede });
      }

      if (proyecto.data.instituciones?.length) {
        secciones.push({
          titulo: 'Instituciones',
          items: proyecto.data.instituciones.map((institucion) => ({ titulo: institucion })),
        });
      }
      if (proyecto.data.colaboradores?.length) {
        secciones.push({
          titulo: 'Colaboradores',
          items: proyecto.data.colaboradores.map((colaborador) => ({
            titulo: colaborador.nombre,
            url: colaborador.enlace,
            meta: colaborador.rol,
          })),
        });
      }
      if (proyecto.data.cursos_relacionados?.length) {
        secciones.push({
          titulo: 'Cursos relacionados',
          items: proyecto.data.cursos_relacionados.map((curso) => ({ titulo: curso })),
        });
      }
      if (proyecto.data.exhibiciones?.length) {
        secciones.push({
          titulo: 'Exhibiciones y selecciones',
          items: proyecto.data.exhibiciones.map((exhibicion) => ({
            titulo: exhibicion.titulo,
            url: exhibicion.enlace,
            etiqueta: exhibicion.tipo,
          })),
        });
      }
      if (proyecto.data.productos?.length) {
        secciones.push({
          titulo: 'Productos',
          items: proyecto.data.productos.map((producto) => ({
            titulo: producto.titulo,
            url: producto.enlace,
            etiqueta: producto.tipo,
          })),
        });
      }
      if (proyecto.data.premios?.length) {
        secciones.push({
          titulo: 'Premios y reconocimientos',
          items: proyecto.data.premios.map((premio) => ({ titulo: premio })),
        });
      }
      if (proyecto.data.menciones_prensa?.length) {
        secciones.push({
          titulo: 'Menciones en prensa',
          items: proyecto.data.menciones_prensa.map((mencion) => ({
            titulo: mencion.titulo,
            url: mencion.enlace,
            meta: mencion.medio,
          })),
        });
      }

      if (proyecto.data.enlaces) {
        for (const [key, url] of Object.entries(proyecto.data.enlaces)) {
          enlaces.push({
            etiqueta: formatearEtiquetaEnlace(key),
            url,
          });
        }
      }
      if (proyecto.data.instagram && !proyecto.data.enlaces?.instagram) {
        enlaces.push({ etiqueta: 'Instagram', url: proyecto.data.instagram });
      }

      return (
        <TarjetaMedia
          id={carpetaGaleria}
          titulo={proyecto.data.titulo}
          fecha={obtenerPeriodoDisplay(proyecto)}
          imagen={proyecto.data.imagen_principal}
          altImagen={proyecto.data.titulo}
          carpetaGaleria={proyecto.data.galeria ? carpetaGaleria : undefined}
          metadatos={metadatos}
          secciones={secciones}
          enlaces={enlaces}
          videos={proyecto.data.videos || []}
        >
          <Content />
        </TarjetaMedia>
      );
    })
  }
</div>
