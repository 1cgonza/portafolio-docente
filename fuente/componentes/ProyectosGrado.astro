---
import { agruparPorAño, crearSlug, ordenarAños } from '@/utilidades/ayudas';
import { getCollection, render } from 'astro:content';

const proyectos = await getCollection('proyectosGrado').then((p) => p.sort((a, b) => a.id.localeCompare(b.id)));
const asistencias = await getCollection('asistentesInvestigacion').then((p) =>
  p.sort((a, b) => a.id.localeCompare(b.id))
);

// Orden configurable de años: 'asc' o 'desc' (por defecto 'desc')
const { orden = 'desc' }: { orden?: 'asc' | 'desc' } = Astro.props;

const proyectosPorAño = agruparPorAño(proyectos);
const asistenciasPorAño = agruparPorAño(asistencias);
const añosProyectos = ordenarAños(proyectosPorAño, orden);
const añosAsistencias = ordenarAños(asistenciasPorAño, orden);
---

{
  añosProyectos.map(async (año) => (
    <section class="proyectosGrado">
      <h4>{año}</h4>
      <ul>
        {proyectosPorAño[año].map(async (proyecto) => {
          const { Content } = await render(proyecto);
          return (
            <li>
              <div class="columna-izq">
                <span class={`caja ${crearSlug(proyecto.data.nivel)}`}>{proyecto.data.nivel}</span>
                <span class={`caja ${crearSlug(proyecto.data.tipo)}`}>{proyecto.data.tipo} </span>{' '}
                <span class="caja año">{proyecto.data.año}</span>
              </div>
              <div class="columna-der">
                <span class="titulo">"{proyecto.data.titulo}"</span> por{' '}
                {proyecto.data.estudiantes.map((estudiante, index) => (
                  <span>
                    {estudiante}
                    {index < proyecto.data.estudiantes.length - 1 ? ', ' : ''}
                  </span>
                ))}{' '}
                - {proyecto.data.programa}
                <div class="notaProyecto">
                  <Content />
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))
}

<h3>Asistentes de Investigación</h3>

<p>
  Los estudiantes a continuación han participado como asistentes de investigación en el Laboratorio EnFlujo como su
  opción de grado.
</p>

<ul class="proyectosGrado">
  {
    añosAsistencias.map(async (año) =>
      asistenciasPorAño[año].map(async (asistencia) => {
        const { Content } = await render(asistencia);
        return (
          <li>
            <div class="columna-izq">
              <span class={`caja ${crearSlug(asistencia.data.nivel)}`}>{asistencia.data.nivel}</span>
              <span class={`caja ${crearSlug(asistencia.data.tipo)}`}>{asistencia.data.tipo}</span>{' '}
              <span class="caja año">{asistencia.data.año}</span>
            </div>
            <div class="columna-der">
              <span class="nombre">{asistencia.data.nombre}</span>
              <div class="notaAsistencia">
                <Content />
              </div>
            </div>
          </li>
        );
      })
    )
  }
</ul>
