---
import { getCollection, render } from 'astro:content';

const paginas = await getCollection('paginasDocencia').then((p) => p.sort((a, b) => a.id.localeCompare(b.id)));
---

{
  paginas &&
    paginas.map(async (pagina) => {
      const { Content } = await render(pagina);
      return (
        <>
          <h3 id={pagina.id}>{pagina.data.titulo}</h3>
          <div class={pagina.data.tipo === 'prosa' ? 'seccion-prosa' : undefined}>
            <Content />
          </div>
        </>
      );
    })
}
