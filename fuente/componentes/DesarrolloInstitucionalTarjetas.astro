---

<div class="listadoTarjetasMedia desarrolloInstitucionalTarjetas">
  {
    actividades.map((actividad) => (
      <TarjetaMedia
        id={actividad.id}
        titulo={actividad.titulo}
        fecha={actividad.fecha}
        nivelTitulo={4}
        imagen={actividad.imagen}
        altImagen={actividad.altImagen}
        carpetaGaleria={actividad.carpetaGaleria}
        metadatos={actividad.metadatos}
        secciones={actividad.secciones}
      >
        {actividad.contenido.map((parrafo) => (
          <p>{parrafo}</p>
        ))}
      </TarjetaMedia>
    ))
  }
</div>
