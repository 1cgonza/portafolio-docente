---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Galeria from '@/componentes/Galeria.astro';

interface Props {
  nivel: 'pregrado' | 'maestria';
}

const { nivel } = Astro.props;
let cursos: CollectionEntry<'cursosPregrado' | 'cursosMaestria'>[] | null = null;

if (nivel === 'pregrado') {
  cursos = await getCollection('cursosPregrado').then((c) => c.sort((a, b) => a.id.localeCompare(b.id)));
} else if (nivel === 'maestria') {
  cursos = await getCollection('cursosMaestria').then((c) => c.sort((a, b) => a.id.localeCompare(b.id)));
}

const cursosRenderizados = cursos
  ? await Promise.all(
      cursos.map(async (pagina) => {
        const { Content } = await render(pagina);
        return { pagina, Content };
      })
    )
  : [];
---

<div class="contenedor-cursos">
  {
    cursosRenderizados.map(({ pagina, Content }) => (
      <section class="curso">
        <h4 id={`${nivel}-${pagina.id}`}>{pagina.data.titulo}</h4>

        <div class="descripcionCurso">
          <div class="col1Descripcion">
            <Content />
          </div>

          <div class="col2Descripcion">
            <h5>Periodos</h5>
            <p>{pagina.data.ciclos.join(', ')}</p>

            <h5>Programa</h5>
            <a href={`/pdfs/${pagina.data.programaPDF}`} target="_blank">
              {pagina.data.titulo} (PDF)
            </a>
            <Galeria carpeta={pagina.data.carpetaPrograma || `programa-${pagina.id}`} limite={2} variante="compacta" />
          </div>
        </div>
      </section>
    ))
  }
</div>
