---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  carpeta: string;
  limite?: number;
  variante?: 'masonry' | 'compacta' | 'tarjeta';
}

const { carpeta, limite, variante = 'masonry' } = Astro.props;

// Importar imágenes como ImageMetadata para obtener dimensiones reales
const todasLasImagenes = import.meta.glob('../imagenes/**/*.{jpg,jpeg,png,webp}', { eager: false });

// Procesar las imágenes de forma asíncrona para obtener metadatos
const imagenesPrometidas = Object.entries(todasLasImagenes)
  .filter(([ruta]) => ruta.includes(`/imagenes/${carpeta}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(async ([ruta, importarImagenes]) => {
    const modulosImagenes = (await importarImagenes()) as { default: ImageMetadata };
    const metadatos = modulosImagenes.default;
    return {
      imagen: metadatos, // Conservamos el objeto ImageMetadata completo
      src: metadatos.src,
      width: metadatos.width,
      height: metadatos.height,
      alt:
        ruta
          .split('/')
          .pop()
          ?.replace(/\.(jpg|jpeg|png|webp)$/, '') ?? 'Imagen',
    };
  });

const imagenes = await Promise.all(imagenesPrometidas);
---

{
  imagenes && imagenes.length > 0 && (
    <div class={`galeria galeria--${variante}`} data-limite={limite} data-total={imagenes.length}>
      {imagenes.map((img, index) => (
        <a
          href={img.src}
          data-pswp-width={img.width}
          data-pswp-height={img.height}
          target="_blank"
          class="imagen-enlace"
          data-index={index}
        >
          <Image src={img.imagen} alt={img.alt} width={320} format="webp" quality={80} loading="lazy" />
        </a>
      ))}
    </div>
  )
}
{(!imagenes || imagenes.length === 0) && <p>No hay imágenes para mostrar en la carpeta: {carpeta}</p>}
