---
import { Image } from 'astro:assets';
import { obtenerImagenesPorCarpeta } from '@/utilidades/imagenes';

interface Props {
  carpeta: string;
  limite?: number;
  variante?: 'masonry' | 'compacta' | 'tarjeta';
}

const { carpeta, limite, variante = 'masonry' } = Astro.props;

const imagenes = obtenerImagenesPorCarpeta(carpeta).map((imagen) => ({
  imagen: imagen.metadata,
  src: imagen.src,
  width: imagen.width,
  height: imagen.height,
  alt: imagen.alt,
}));
---

{
  imagenes.length > 0 && (
    <div class={`galeria galeria--${variante}`} data-limite={limite} data-total={imagenes.length}>
      {imagenes.map((img, index) => (
        <a
          href={img.src}
          data-pswp-width={img.width}
          data-pswp-height={img.height}
          target="_blank"
          class="imagen-enlace"
          data-index={index}
        >
          <Image src={img.imagen} alt={img.alt} width={320} format="webp" quality={80} loading="lazy" />
        </a>
      ))}
    </div>
  )
}
{imagenes.length === 0 && <p>No hay imagenes para mostrar en la carpeta: {carpeta}</p>}
