---
import Plantilla from '@/plantillas/Plantilla.astro';
import { getCollection, render } from 'astro:content';

const paginas = await getCollection('paginas').then((p) => p.sort((a, b) => a.id.localeCompare(b.id)));
const paginasDocencia = await getCollection('paginasDocencia').then((p) => p.sort((a, b) => a.id.localeCompare(b.id)));
---

<Plantilla>
  <nav id="menu">
    <ul>
      {
        paginas.map((pagina) => (
          <li>
            <a href={`#${pagina.id}`}>{pagina.data.titulo}</a>
            {pagina.id === '02_docencia' && (
              <ul>
                {paginasDocencia.map((pDocencia) => (
                  <li>
                    <a href={`#${pDocencia.id}`}>{pDocencia.data.titulo}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>

  <main>
    <header>
      <h1>Portafolio docente, Juan Camilo González Jiménez</h1>
      <p>2025</p>
    </header>

    {
      paginas.map(async (pagina) => {
        const { Content } = await render(pagina);
        return (
          <>
            <h2 id={pagina.id}>{pagina.data.titulo}</h2>
            <div>
              <Content />
            </div>
          </>
        );
      })
    }
  </main>
</Plantilla>
